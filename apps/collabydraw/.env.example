# ─────────────────────────────────────────────────────────────────────────────
# CollabyDraw — Environment Variables Template
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Development (SQLite — no setup required)
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL — uncomment and fill in)
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/collabydraw?schema=public&sslmode=require"
# Recommended providers:
#   Neon (free tier):     https://neon.tech
#   Supabase (free tier): https://supabase.com
#   Railway:              https://railway.app

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"
JWT_SECRET="change-me-in-production-use-openssl-rand-base64-32"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create an OAuth App at: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── WebSocket Server ──────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_WS_URL="ws://localhost:8080"

# ── AI (Gemini) ───────────────────────────────────────────────────────────────
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# ── Redis (optional — for WS horizontal scaling) ─────────────────────────────
# Leave empty to fall back to in-memory broadcasting
REDIS_URL=