// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

// ── Database ──────────────────────────────────────────────────────────────────
// Development:  DATABASE_URL="file:./dev.db"            (SQLite)
// Production:   DATABASE_URL="postgresql://..."         (PostgreSQL / Neon / Supabase)
// Switch by changing the provider env var and re-running: pnpm exec prisma migrate deploy
datasource db {
  provider = "sqlite" // Change to "postgresql" for production
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  plan          String    @default("FREE")
  aiCredits     Int       @default(50)

  // Phase 4/5: Stripe billing & Roles
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus   String? // active | trialing | canceled | past_due
  
  // Phase 5: SaaS Monetization fields
  role          String    @default("USER") // USER | ADMIN
  trialEndsAt   DateTime?
  referralCode  String?   @unique
  referredById  String?
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]    @relation("Referrals")

  boards        Board[]
  members       BoardMember[]
  accounts      Account[]
  sessions      Session[]
  Room          Room[]
  Shape         Shape[]
  folders       Folder[]
  notifications Notification[]
  subscriptions Subscription[]
  aiUsageLogs   AiUsage[]

  // Phase 7: Template Marketplace
  templates     Template[]         @relation("CreatedTemplates")
  purchases     TemplatePurchase[] @relation("TemplatePurchases")

  apiKeys       ApiKey[]
  webhooks      Webhook[]
  integrations  Integration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Board {
  id          String   @id @default(cuid())
  name        String   @default("Untitled Board")
  description String?
  thumbnail   String?
  color       String?
  icon        String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isPublic    Boolean  @default(false)
  publicRole  String   @default("NONE") // NONE | VIEWER | EDITOR
  isPinned    Boolean  @default(false)
  shapes      String   @default("[]")  // JSON stringified shapes array
  members     BoardMember[]
  room        Room?
  folderBoards FolderBoard[]
  invites     BoardInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BoardMember {
  boardId String
  userId  String
  role    String @default("VIEWER") // OWNER | EDITOR | VIEWER | COMMENTER
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
}

model Room {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  boardId   String?  @unique
  board     Board?   @relation(fields: [boardId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Shape     Shape[]
}

model Shape {
  id        String   @id @default(uuid())
  message   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roomId    String
  Room      Room     @relation(fields: [roomId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Phase 5: Board version history — auto-snapshots of shapes JSON
model BoardSnapshot {
  id         String   @id @default(cuid())
  boardId    String
  shapes     String   // JSON stringified shapes at this point in time
  label      String?  // optional user-facing label e.g. "Before AI layout"
  shapeCount Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([boardId, createdAt])
}

// Phase 4: Workspace Folders
model Folder {
  id      String  @id @default(cuid())
  name    String
  ownerId String
  owner   User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  boards  FolderBoard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FolderBoard {
  folderId String
  boardId  String
  folder   Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@id([folderId, boardId])
}

// Phase 7: Template Marketplace
model Template {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String   @default("general")
  thumbnail   String?
  shapes      String   @default("[]") // JSON stringified shapes
  price       Float    @default(0)
  isPaid      Boolean  @default(false)
  authorId    String
  author      User     @relation("CreatedTemplates", fields: [authorId], references: [id], onDelete: Cascade)
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())

  purchases   TemplatePurchase[]
}

model TemplatePurchase {
  id         String   @id @default(cuid())
  templateId String
  userId     String
  price      Float
  createdAt  DateTime @default(now())

  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user       User     @relation("TemplatePurchases", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId])
}

// Phase 4: Board Invites
model BoardInvite {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  email     String
  role      String   @default("VIEWER")
  token     String   @unique @default(cuid())
  expiresAt DateTime
  accepted  Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([token])
}

// Phase 4: Activity Notifications
model Notification {
  id      String  @id @default(cuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    String  // board_invite | comment_added | board_shared | member_joined
  payload String  @default("{}") // JSON: { boardId, boardName, actorName, message, ... }
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
}

// Phase 5: Subscription Model
model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String   @unique
  stripeCustomerId     String
  stripePriceId        String
  status               String   // active, canceled, past_due, trialing
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

// Phase 5: AI Usage Tracking
model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g., "diagram_generation", "credit_purchase"
  credits   Int      // positive for purchase, negative for usage
  metadata  String?  // JSON string for additional details

  createdAt DateTime @default(now())

  @@index([userId])
}

// Phase 6: Ecosystem - API Keys
model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique // Hashed or plain (plain for simplicity here, but should be hashed in prod)
  name      String   @default("My API Key")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Phase 6: Ecosystem - Webhooks
model Webhook {
  id        String   @id @default(cuid())
  url       String
  secret    String?  // Optional secret to sign payloads
  events    String   @default("[]") // JSON array of event types like ["board.created", "shape.added"]
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Phase 6: Ecosystem - Integrations (Slack, GitHub tokens, etc.)
model Integration {
  id        String   @id @default(cuid())
  provider  String   // "slack", "github", "jira"
  config    String   // JSON containing webhook URLs or tokens
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
}


