// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  plan          String    @default("FREE")
  aiCredits     Int       @default(50)

  boards        Board[]
  members       BoardMember[]
  accounts      Account[]
  sessions      Session[]
  Room          Room[]
  Shape         Shape[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Board {
  id          String   @id @default(cuid())
  name        String   @default("Untitled Board")
  description String?
  thumbnail   String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isPublic    Boolean  @default(false)
  isPinned    Boolean  @default(false)
  shapes      String   @default("[]")  // JSON stringified shapes array
  members     BoardMember[]
  room        Room?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BoardMember {
  boardId String
  userId  String
  role    String @default("VIEWER") // OWNER | EDITOR | VIEWER | COMMENTER
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
}

model Room {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id])
  boardId   String?  @unique
  board     Board?   @relation(fields: [boardId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Shape     Shape[]
}

model Shape {
  id        String   @id @default(uuid())
  message   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roomId    String
  Room      Room     @relation(fields: [roomId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Phase 5: Board version history — auto-snapshots of shapes JSON
model BoardSnapshot {
  id        String   @id @default(cuid())
  boardId   String
  shapes    String   // JSON stringified shapes at this point in time
  label     String?  // optional user-facing label e.g. "Before AI layout"
  shapeCount Int     @default(0)
  createdAt DateTime @default(now())

  @@index([boardId, createdAt])
}
